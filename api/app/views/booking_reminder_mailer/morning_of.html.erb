<div class="header">
  <h1>⛳ Today's Tee Time</h1>
</div>

<div class="card">
  <p>Good morning, <%= @user.first_name %>! ☀️</p>
  <p>Your tee time at <strong><%= @course.name %></strong> is today at <strong><%= @tee_time.formatted_time %></strong>.</p>

  <table style="width: 100%; border-collapse: collapse; margin: 24px 0;">
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #e4e4e7; color: #71717a; font-size: 14px;">Tee Time</td>
      <td style="padding: 10px 0; border-bottom: 1px solid #e4e4e7; font-weight: 600; text-align: right;"><%= @tee_time.formatted_time %></td>
    </tr>
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #e4e4e7; color: #71717a; font-size: 14px;">Players</td>
      <td style="padding: 10px 0; border-bottom: 1px solid #e4e4e7; font-weight: 600; text-align: right;"><%= @booking.players_count %></td>
    </tr>
    <tr>
      <td style="padding: 10px 0; color: #71717a; font-size: 14px;">Confirmation Code</td>
      <td style="padding: 10px 0; font-weight: 600; text-align: right; font-family: monospace; letter-spacing: 2px;"><%= @booking.confirmation_code %></td>
    </tr>
  </table>

  <p style="margin-top: 24px; font-size: 14px; color: #71717a;">
    Remember to arrive at least 15 minutes early. Have a great round! 🏌️‍♂️
  </p>
</div>

<div class="footer">
  <p><%= @organization.name %></p>
  <p>This reminder was sent to <%= @user.email %> regarding your tee time today.</p>
</div>
